# PostgreSQL: pooled runtime connection and direct connection for Prisma migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret-of-at-least-32-characters"

# Persistent Supabase Storage. Create a public bucket named site-media.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="site-media"

# Shared rate limiting for serverless production deployments (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional enquiry email notifications (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
ENQUIRY_NOTIFICATION_EMAIL=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
